{
  "name": "Tau3Mu visual analysis",
  "workflow": {
    "id": "workflow",
    "name": "Workflow",
    "scope": "workflow",
    "nodes": [
      {
        "id": "root_input",
        "type": "root_files",
        "title": "Signal ROOT files",
        "x": 0.0,
        "y": 120.0,
        "properties": {
          "directory": "./Ntuple/Sanae/SIGNAL/MC15ri",
          "pattern": "*.root",
          "label": "SIGNAL"
        }
      },
      {
        "id": "analysis",
        "type": "analysis_stage",
        "title": "Primary analysis",
        "x": 300.0,
        "y": 120.0,
        "properties": {
          "executable": "./analysis_code/bin/Analysis_main",
          "arguments": "{input_dir} {filename} {output_dir}",
          "output_dir": "./Sanae/v000/SIGNAL",
          "run_mode": "per_file",
          "pipeline": "main_analysis",
          "job_name": "Analyze"
        }
      },
      {
        "id": "validate",
        "type": "validator",
        "title": "Check analysis logs",
        "x": 600.0,
        "y": 120.0,
        "properties": {
          "executable": "/bin/bash",
          "arguments": "./bash/checker_Analysis.sh",
          "output_dir": "",
          "run_mode": "once",
          "job_name": "Validate"
        }
      },
      {
        "id": "fit",
        "type": "command_stage",
        "title": "Fit M and deltaE",
        "x": 900.0,
        "y": 120.0,
        "properties": {
          "executable": "./analysis_code/bin/fit_M_deltaE",
          "arguments": "{input_dir}/before_strict_M_deltaE_selection {output_dir}",
          "output_dir": "./Sanae/v000",
          "run_mode": "once",
          "job_name": "2DFIT"
        }
      }
    ],
    "edges": [
      {
        "id": "edge_input_analysis",
        "source": "root_input",
        "source_port": "out",
        "target": "analysis",
        "target_port": "in"
      },
      {
        "id": "edge_analysis_validate",
        "source": "analysis",
        "source_port": "out",
        "target": "validate",
        "target_port": "in"
      },
      {
        "id": "edge_validate_fit",
        "source": "validate",
        "source_port": "out",
        "target": "fit",
        "target_port": "in"
      }
    ]
  },
  "loader_graphs": {
    "main_analysis": {
      "id": "main_analysis",
      "name": "Main analysis",
      "scope": "loader",
      "nodes": [
        {
          "id": "loader_load",
          "type": "load_with_cut",
          "title": "Load prompt decay",
          "x": 0.0,
          "y": 100.0,
          "properties": {
            "directory_cpp": "argv[1]",
            "including_cpp": "argv[2]",
            "label": "label",
            "condition": "(0.5 < extraInfo__bodecayModeID__bc) && (extraInfo__bodecayModeID__bc < 1.5)"
          }
        },
        {
          "id": "loader_define",
          "type": "define_variable",
          "title": "Define charge × ROE charge",
          "x": 290.0,
          "y": 100.0,
          "properties": {
            "equation": "charge*roeCharge__bocleanMask__bc",
            "name": "charge_times_ROEcharge"
          }
        },
        {
          "id": "loader_cut_de",
          "type": "cut",
          "title": "deltaE selection",
          "x": 580.0,
          "y": 100.0,
          "properties": {
            "condition": "(-0.5 < deltaE) && (deltaE < 0.4)"
          }
        },
        {
          "id": "loader_cut_m",
          "type": "cut",
          "title": "Mass selection",
          "x": 870.0,
          "y": 100.0,
          "properties": {
            "condition": "(1.5 < M) && (M < 1.9)"
          }
        },
        {
          "id": "loader_save",
          "type": "save_root",
          "title": "Save fit input",
          "x": 1160.0,
          "y": 100.0,
          "properties": {
            "path_cpp": "std::string(argv[3]) + \"/before_strict_M_deltaE_selection\"",
            "prefix": "",
            "suffix": ""
          }
        }
      ],
      "edges": [
        {
          "id": "loader_edge_1",
          "source": "loader_load",
          "source_port": "out",
          "target": "loader_define",
          "target_port": "in"
        },
        {
          "id": "loader_edge_2",
          "source": "loader_define",
          "source_port": "out",
          "target": "loader_cut_de",
          "target_port": "in"
        },
        {
          "id": "loader_edge_3",
          "source": "loader_cut_de",
          "source_port": "out",
          "target": "loader_cut_m",
          "target_port": "in"
        },
        {
          "id": "loader_edge_4",
          "source": "loader_cut_m",
          "source_port": "out",
          "target": "loader_save",
          "target_port": "in"
        }
      ]
    }
  },
  "backend": "local",
  "backend_options": {
    "local_workers": 4,
    "lsf_queue": "s",
    "condor_universe": "vanilla"
  },
  "version": 1
}
