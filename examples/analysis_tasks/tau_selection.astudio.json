          "type": "cut_flow",
          "title": "Preselection",
          "x": 580,
          "y": 70,
          "properties": {
            "steps": [
              {
                "enabled": true,
                "name": "Energy window",
                "condition": "(-0.3 < deltaE) && (deltaE < 0.15)",
                "report": true
              },
              {
                "enabled": true,
                "name": "Mass window",
                "condition": "(1.71 < M) && (M < 1.82)",
                "report": true
              },
              {
                "enabled": false,
                "name": "Leading muon ID",
                "condition": "0.5 < first_muon_muonID",
                "report": true
              },
              {
                "enabled": false,
                "name": "Second muon ID",
                "condition": "0.5 < second_muon_muonID",
                "report": true
              }
            ],
            "plot_timing": "none",
            "plots": [
              {
                "enabled": true,
                "expression": "M",
                "title": ";M [GeV];Events",
                "bins": 50,
                "minimum": 1.5,
                "maximum": 1.9,
                "filename": "M.png"
              }
            ],
            "output_directory": "plots"
